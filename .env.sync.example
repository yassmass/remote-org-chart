# Template for `.env.sync`, read by `scripts/sync.ts` when `pnpm sync` runs.
#
# No application code reads these values and the deployed system has none
# configured. The chart renders from the committed `data/snapshot.json`, and the
# deployed app performs no network I/O — a token is needed only to re-capture
# data. (build.md NFR 3, F8)
#
# The filename sits outside Next's env load order, so the token stays out of the
# application's `process.env` in every environment, including local development.
#
# `.env.sync` is git-ignored. This template is the committed record of what the
# sync requires, and carries no real value.

# Remote Customer API token for the sandbox, sent as `Authorization: Bearer`.
# Prefix `ra_test_`, asserted at startup, so an `ra_live_` token fails fast
# instead of returning confusing 401s against the sandbox gateway.
# Scope: `employment:read`, or an enclosing scope.
# 401 means expired or revoked; 403 means valid but missing that scope. Those
# have different owners and different fixes, and the sync reports them apart.
# Values are read verbatim: quotes and trailing whitespace become part of it.
REMOTE_API_TOKEN=

# Remote API gateway, including the `/v1` segment. Optional; this is the default.
# Production is `https://gateway.remote.com/v1` and issues `ra_live_` tokens,
# which the prefix assertion above rejects.
REMOTE_API_BASE_URL=https://gateway.remote-sandbox.com/v1
